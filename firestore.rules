rules_version = '2';

// NOTE: this app has no login/auth system (by design, per the project scope),
// so these rules can only do basic shape validation, not "does this request
// really come from the device it claims to be." Anyone with the Firebase web
// API key (which ships inside every Android APK) can technically write here.
// If you need real per-device write isolation, add Firebase Anonymous Auth
// and require request.auth.uid == deviceId on the devices/{deviceId} match.
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per installed app instance: FCM token + per-listener/per-sound-label opt-outs.
    match /devices/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(
        ['fcmToken', 'displayName', 'mutedListenerIds', 'updatedAt']
      );
      allow delete: if false;
    }

    // A human-named group of similar-sounding noiseEvents (see DspAudioAnalyzer's
    // fingerprint + functions/index.js's auto-matching). Never deleted so
    // existing noiseEvents.soundLabelId references stay valid.
    match /soundLabels/{labelId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(
        ['name', 'nameLower', 'physicalSoundType', 'centroid', 'sampleCount']
      );
      allow delete: if false;
    }

    // One doc per registered "sound source" (a device acting as a listener).
    match /listeners/{listenerId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(
        ['name', 'ownerDeviceId', 'active', 'thresholdAmplitude', 'minDurationMs']
      );
      allow delete: if false;
    }

    // Append-only log of detected noise episodes; the Cloud Function reads
    // these via onDocumentCreated (Admin SDK, bypasses these rules entirely)
    // and clients should never edit/delete the logged event data itself. The
    // deliberate exceptions: a client may attach a human-assigned sound label
    // after the fact (SoundLabelManager), or hide it from the unnamed-sounds
    // review queue without naming it (swipe-to-dismiss / "clear all") -
    // nothing else may change.
    match /noiseEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
        ['listenerId', 'listenerName', 'durationSec']
      );
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['soundLabelId', 'soundLabelName', 'labelSource', 'dismissed']);
      allow delete: if false;
    }
  }
}
